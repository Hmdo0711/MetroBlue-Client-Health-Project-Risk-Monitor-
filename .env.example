# Copy to .env and start with: node --env-file=.env server/src/index.js  (or set in your process manager). All optional.
PORT=4000
AUTH_MODE=dev                 # use "header" behind the SSO proxy in production
# DATA_FILE=/path/to/metroblue-export.json
# HEALTH_RULES_FILE=/path/to/rules-overrides.json
SUMMARY_SCHEDULE=on
SUMMARY_DAY=1                 # Monday
SUMMARY_HOUR=8
# SUMMARY_WEBHOOK_URL=https://hooks.example.com/metroblue-health
# VAR_DIR=/var/lib/metroblue-health
# AS_OF=2026-11-12
